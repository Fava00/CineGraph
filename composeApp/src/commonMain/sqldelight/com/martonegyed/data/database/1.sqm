-- Recovery archive for legacy cached credits whose movie no longer exists.
-- Intentionally has no foreign key; rows retain their original identity and content.
CREATE TABLE IF NOT EXISTS RecoveryMoviePersonEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    originalId INTEGER NOT NULL,
    movieId INTEGER NOT NULL,
    name TEXT NOT NULL,
    job TEXT NOT NULL,
    character TEXT,
    profilePath TEXT
);

INSERT INTO RecoveryMoviePersonEntity(originalId, movieId, name, job, character, profilePath)
SELECT id, movieId, name, job, character, profilePath FROM MoviePersonEntity
WHERE NOT EXISTS (SELECT 1 FROM MovieEntity WHERE MovieEntity.id = MoviePersonEntity.movieId);

-- v1 -> v2: preserve integer IDs and data; add stable identity and separate library state.
CREATE TABLE MovieEntity_next (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    year INTEGER NOT NULL,
    letterboxdUri TEXT UNIQUE,
    imdbId TEXT UNIQUE,

    isCached INTEGER NOT NULL DEFAULT 0,

    posterPath TEXT,
    backdropPath TEXT,
    overview TEXT,
    runtimeMinutes INTEGER,
    tmdbId TEXT,

    tagline TEXT,
    originalTitle TEXT,
    originalLanguage TEXT,
    budget INTEGER,
    revenue INTEGER,
    genres TEXT,

    -- New in v2
    hungarianTitle TEXT,
    tmdbPopularity REAL,
    tmdbVoteAverage REAL,
    tmdbVoteCount INTEGER,
    collectionName TEXT,
    trailerKey TEXT,
    mpaaRating TEXT,
    studios TEXT,
    productionCountries TEXT,
    spokenLanguages TEXT,
    similarMovies TEXT,
    tmdbReviews TEXT
);

CREATE TABLE MoviePersonEntity_next (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    name TEXT NOT NULL,
    job TEXT NOT NULL,
    character TEXT,
    profilePath TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity_next(id) ON DELETE CASCADE
);

CREATE TABLE MovieLogEntity_next (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    watchedDate TEXT,
    loggedDate TEXT,
    rating REAL,
    review TEXT,
    isRewatch INTEGER NOT NULL DEFAULT 0,
    sourceType TEXT NOT NULL,
    FOREIGN KEY (movieId) REFERENCES MovieEntity_next(id) ON DELETE CASCADE
);

CREATE TABLE CustomList_next (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE ListEntry_next (
    listId INTEGER NOT NULL,
    movieId INTEGER NOT NULL,
    PRIMARY KEY (listId, movieId),
    FOREIGN KEY (listId) REFERENCES CustomList_next(id) ON DELETE CASCADE,
    FOREIGN KEY (movieId) REFERENCES MovieEntity_next(id) ON DELETE CASCADE
);

CREATE TABLE LibraryMovieEntity_next (
    movieId INTEGER NOT NULL PRIMARY KEY,
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    isWatched INTEGER NOT NULL DEFAULT 0,
    inWatchlist INTEGER NOT NULL DEFAULT 0,
    addedDate TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity_next(id) ON DELETE CASCADE
);

INSERT INTO MovieEntity_next (id, name, year, letterboxdUri, imdbId, isCached, posterPath, backdropPath, overview, runtimeMinutes, tmdbId, tagline, originalTitle, originalLanguage, budget, revenue, genres, hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount, collectionName, trailerKey, mpaaRating, studios, productionCountries, spokenLanguages, similarMovies, tmdbReviews)
SELECT id, name, year, letterboxdUri, imdbId, isCached, posterPath, backdropPath, overview, runtimeMinutes, tmdbId, tagline, originalTitle, originalLanguage, budget, revenue, genres, hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount, collectionName, trailerKey, mpaaRating, studios, productionCountries, spokenLanguages, similarMovies, tmdbReviews FROM MovieEntity;
INSERT INTO MoviePersonEntity_next (id, movieId, name, job, character, profilePath)
SELECT id, movieId, name, job, character, profilePath FROM MoviePersonEntity
WHERE EXISTS (SELECT 1 FROM MovieEntity WHERE MovieEntity.id = MoviePersonEntity.movieId);
INSERT INTO MovieLogEntity_next (id, movieId, watchedDate, loggedDate, rating, review, isRewatch, sourceType)
SELECT id, movieId, watchedDate, loggedDate, rating, review, isRewatch, sourceType FROM MovieLogEntity;
INSERT INTO CustomList_next (id, name)
SELECT id, name FROM CustomList;
INSERT INTO ListEntry_next (listId, movieId)
SELECT listId, movieId FROM ListEntry;
INSERT INTO LibraryMovieEntity_next (movieId, isWatched, inWatchlist, addedDate)
SELECT id, isWatched, inWatchlist, addedDate FROM MovieEntity;
-- Retain AUTOINCREMENT high-water marks, including previously deleted rows.
UPDATE sqlite_sequence SET seq = max(seq, COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'MovieEntity'), 0)) WHERE name = 'MovieEntity_next';
UPDATE sqlite_sequence SET seq = max(seq, COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'MovieLogEntity'), 0)) WHERE name = 'MovieLogEntity_next';
UPDATE sqlite_sequence SET seq = max(seq, COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'MoviePersonEntity'), 0)) WHERE name = 'MoviePersonEntity_next';
UPDATE sqlite_sequence SET seq = max(seq, COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'CustomList'), 0)) WHERE name = 'CustomList_next';

DROP TABLE ListEntry;
DROP TABLE MoviePersonEntity;
DROP TABLE MovieLogEntity;
DROP TABLE CustomList;
DROP TABLE MovieEntity;
ALTER TABLE MovieEntity_next RENAME TO MovieEntity;
ALTER TABLE MoviePersonEntity_next RENAME TO MoviePersonEntity;
ALTER TABLE MovieLogEntity_next RENAME TO MovieLogEntity;
ALTER TABLE CustomList_next RENAME TO CustomList;
ALTER TABLE ListEntry_next RENAME TO ListEntry;
ALTER TABLE LibraryMovieEntity_next RENAME TO LibraryMovieEntity;

CREATE VIEW MovieWithLibraryState AS
SELECT
    m.id,
    m.name,
    m.year,
    m.letterboxdUri,
    m.imdbId,
    COALESCE(l.isWatched, 0) AS isWatched,
    COALESCE(l.inWatchlist, 0) AS inWatchlist,
    m.isCached,
    m.posterPath,
    m.backdropPath,
    m.overview,
    m.runtimeMinutes,
    m.tmdbId,
    m.tagline,
    m.originalTitle,
    m.originalLanguage,
    m.budget,
    m.revenue,
    m.genres,
    m.hungarianTitle,
    m.tmdbPopularity,
    m.tmdbVoteAverage,
    m.tmdbVoteCount,
    m.collectionName,
    m.trailerKey,
    m.mpaaRating,
    l.addedDate,
    m.studios,
    m.productionCountries,
    m.spokenLanguages,
    m.similarMovies,
    m.tmdbReviews,
    m.stableId,
    l.stableId AS libraryStableId
FROM MovieEntity m
LEFT JOIN LibraryMovieEntity l ON l.movieId = m.id;

CREATE INDEX IF NOT EXISTS idx_librarymovie_iswatched
ON LibraryMovieEntity(isWatched);
CREATE INDEX IF NOT EXISTS idx_movielog_movie_date
ON MovieLogEntity(movieId, watchedDate);
CREATE INDEX IF NOT EXISTS idx_movieperson_movie
ON MoviePersonEntity(movieId);
CREATE INDEX IF NOT EXISTS idx_movielog_movie_watched
ON MovieLogEntity(movieId, watchedDate);
CREATE INDEX IF NOT EXISTS idx_movielog_movie_logged
ON MovieLogEntity(movieId, loggedDate);
CREATE INDEX IF NOT EXISTS idx_movieperson_movie_job_name
ON MoviePersonEntity(movieId, job, name);
CREATE INDEX IF NOT EXISTS idx_movieperson_job_name_movie
ON MoviePersonEntity(job, name, movieId);
