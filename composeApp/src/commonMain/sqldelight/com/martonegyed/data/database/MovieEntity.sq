getCollectionRowsByPersonAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS userRating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieEntity m
JOIN MoviePersonEntity p ON p.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p.name = :personName
    AND (:job IS NULL OR p.job = :job)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
                  OR (
                      log.watchedDate IS NULL
                      AND log.loggedDate BETWEEN :startDate AND :endDate
                      AND NOT EXISTS (
                          SELECT 1
                          FROM MovieLogEntity w
                          WHERE w.movieId = m.id
                            AND w.watchedDate IS NOT NULL
                      )
                  )
              )
        )
    );

getCollectionRowsByFilterAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS userRating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieEntity m
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND (
        (:filterType = 'GENRE' AND m.genres LIKE '%' || :filterName || '%') OR
        (:filterType = 'STUDIO' AND m.studios LIKE '%' || :filterName || '%') OR
        (:filterType = 'COUNTRY' AND m.productionCountries LIKE '%' || :filterName || '%')
    )
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
                  OR (
                      log.watchedDate IS NULL
                      AND log.loggedDate BETWEEN :startDate AND :endDate
                      AND NOT EXISTS (
                          SELECT 1
                          FROM MovieLogEntity w
                          WHERE w.movieId = m.id
                            AND w.watchedDate IS NOT NULL
                      )
                  )
              )
        )
    );

getCollectionRowsByDuoAndDate:
SELECT DISTINCT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS userRating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieEntity m
JOIN MoviePersonEntity p1 ON p1.movieId = m.id
JOIN MoviePersonEntity p2 ON p2.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p1.name = :firstName
    AND p2.name = :secondName
    AND p1.id != p2.id
    AND (:firstJob IS NULL OR p1.job = :firstJob)
    AND (:secondJob IS NULL OR p2.job = :secondJob)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
                  OR (
                      log.watchedDate IS NULL
                      AND log.loggedDate BETWEEN :startDate AND :endDate
                      AND NOT EXISTS (
                          SELECT 1
                          FROM MovieLogEntity w
                          WHERE w.movieId = m.id
                            AND w.watchedDate IS NOT NULL
                      )
                  )
              )
        )
    );

-- =============================================================================
-- Queries: Entity Suggestions
-- =============================================================================
getPersonSuggestionsByJob:
SELECT DISTINCT name
FROM MoviePersonEntity
WHERE job = :job
  AND name LIKE '%' || :query || '%'
ORDER BY name COLLATE NOCASE
LIMIT 8;

getActorActorDuosByDate:
WITH watched_movies AS (
    SELECT DISTINCT m.id
    FROM MovieEntity m
    WHERE m.isWatched = 1
      AND (
        :startDate IS NULL OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate BETWEEN :startDate AND :endDate
        )
      )
)
SELECT
    CASE WHEN p1.name <= p2.name THEN p1.name ELSE p2.name END AS leftName,
    CASE WHEN p1.name <= p2.name THEN p2.name ELSE p1.name END AS rightName,
    CASE WHEN p1.name <= p2.name THEN COALESCE(p1.profilePath, p2.profilePath)
         ELSE COALESCE(p2.profilePath, p1.profilePath) END AS leftPhotoPath,
    CASE WHEN p1.name <= p2.name THEN COALESCE(p2.profilePath, p1.profilePath)
         ELSE COALESCE(p1.profilePath, p2.profilePath) END AS rightPhotoPath,
    COUNT(DISTINCT wm.id) AS count
FROM watched_movies wm
JOIN MoviePersonEntity p1 ON p1.movieId = wm.id
JOIN MoviePersonEntity p2 ON p2.movieId = wm.id
WHERE p1.job = 'Actor'
  AND p2.job = 'Actor'
  AND p1.id < p2.id
  AND p1.name != p2.name
GROUP BY leftName, rightName
HAVING COUNT(DISTINCT wm.id) >= 2
ORDER BY count DESC, leftName ASC, rightName ASC;

getActorDirectorDuosByDate:
WITH watched_movies AS (
    SELECT DISTINCT m.id
    FROM MovieEntity m
    WHERE m.isWatched = 1
      AND (
        :startDate IS NULL OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate BETWEEN :startDate AND :endDate
        )
      )
)
SELECT
    actor.name AS leftName,
    director.name AS rightName,
    actor.profilePath AS leftPhotoPath,
    director.profilePath AS rightPhotoPath,
    COUNT(DISTINCT wm.id) AS count
FROM watched_movies wm
JOIN MoviePersonEntity actor ON actor.movieId = wm.id
JOIN MoviePersonEntity director ON director.movieId = wm.id
WHERE actor.job = 'Actor'
  AND director.job = 'Director'
  AND actor.name != director.name
GROUP BY actor.name, director.name
HAVING COUNT(DISTINCT wm.id) >= 2
ORDER BY count DESC, leftName ASC, rightName ASC;


deleteAllData:
DELETE FROM MovieEntity;
DELETE FROM MovieLogEntity;
DELETE FROM MoviePersonEntity;

-- =============================================================================
-- For Exports
-- =============================================================================


selectAllMovieEntities:
SELECT * FROM MovieEntity ORDER BY id;

selectAllMoviePersons:
SELECT * FROM MoviePersonEntity ORDER BY movieId, id;

selectAllMovieLogs:
SELECT * FROM MovieLogEntity ORDER BY movieId, COALESCE(watchedDate, loggedDate), id;

selectAllCustomLists:
SELECT * FROM CustomList ORDER BY id;

selectAllListEntries:
SELECT * FROM ListEntry ORDER BY listId, movieId;

selectAllIgnoredMovies:
SELECT * FROM DiscoveryIgnoredEntity ORDER BY createdAt DESC;