-- =============================================================================
-- Schema Version 3
-- Added: hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount,
--        collectionName, trailerKey, mpaaRating, studios, productionCountries,
--        spokenLanguages, similarMovies (JSON), tmdbReviews (JSON), addedDate
-- =============================================================================

CREATE TABLE MovieEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    year INTEGER NOT NULL,
    letterboxdUri TEXT UNIQUE,
    imdbId TEXT UNIQUE,

    isWatched INTEGER NOT NULL DEFAULT 0,
    inWatchlist INTEGER NOT NULL DEFAULT 0,
    isCached INTEGER NOT NULL DEFAULT 0,

    posterPath TEXT,
    backdropPath TEXT,
    overview TEXT,
    runtimeMinutes INTEGER,
    tmdbId TEXT,

    tagline TEXT,
    originalTitle TEXT,
    originalLanguage TEXT,
    budget INTEGER,
    revenue INTEGER,
    genres TEXT,

    -- New in v2
    hungarianTitle TEXT,
    tmdbPopularity REAL,
    tmdbVoteAverage REAL,
    tmdbVoteCount INTEGER,
    collectionName TEXT,
    trailerKey TEXT,
    mpaaRating TEXT,
    addedDate TEXT,
    studios TEXT,
    productionCountries TEXT,
    spokenLanguages TEXT,
    similarMovies TEXT,
    tmdbReviews TEXT
);

CREATE TABLE MoviePersonEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    name TEXT NOT NULL,
    job TEXT NOT NULL,
    character TEXT,
    profilePath TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE MovieLogEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    watchedDate TEXT,
    loggedDate TEXT,
    rating REAL,
    review TEXT,
    isRewatch INTEGER NOT NULL DEFAULT 0,
    sourceType TEXT NOT NULL,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE CustomList (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE ListEntry (
    listId INTEGER NOT NULL,
    movieId INTEGER NOT NULL,
    PRIMARY KEY (listId, movieId),
    FOREIGN KEY (listId) REFERENCES CustomList(id) ON DELETE CASCADE,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE DiscoveryIgnoredEntity (
  tmdbId INTEGER NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  year INTEGER,
  posterPath TEXT,
  overview TEXT,
  runtimeMinutes INTEGER,
  tmdbVoteAverage REAL,
  createdAt TEXT NOT NULL
);

-- =============================================================================
-- Indexes for performance-critical queries
-- =============================================================================

CREATE INDEX IF NOT EXISTS idx_movieentity_iswatched
ON MovieEntity(isWatched);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_date
ON MovieLogEntity(movieId, watchedDate);

CREATE INDEX IF NOT EXISTS idx_movieperson_movie
ON MoviePersonEntity(movieId);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_watched
ON MovieLogEntity(movieId, watchedDate);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_logged
ON MovieLogEntity(movieId, loggedDate);

CREATE INDEX IF NOT EXISTS idx_movieperson_movie_job_name
ON MoviePersonEntity(movieId, job, name);

CREATE INDEX IF NOT EXISTS idx_movieperson_job_name_movie
ON MoviePersonEntity(job, name, movieId);

-- =============================================================================
-- Queries: Persons
-- =============================================================================

insertMoviePerson:
INSERT INTO MoviePersonEntity(movieId, name, job, character, profilePath)
VALUES (?, ?, ?, ?, ?);

deletePersonsForMovie:
DELETE FROM MoviePersonEntity
WHERE movieId = ?;

getPersonsForMovie:
SELECT *
FROM MoviePersonEntity
WHERE movieId = ?;

getPersonsForMovies:
SELECT *
FROM MoviePersonEntity
WHERE movieId IN ?;

-- =============================================================================
-- Queries: Movie Log
-- =============================================================================

insertMovieLog:
INSERT INTO MovieLogEntity(movieId, watchedDate, loggedDate, rating, review, isRewatch, sourceType)
VALUES (?, ?, ?, ?, ?,?,?);

getLogByMovieAndDate:
SELECT * FROM MovieLogEntity
WHERE movieId = :movieId
  AND ((watchedDate IS NULL AND :date IS NULL) OR (watchedDate = :date))
LIMIT 1;

getLogByMovieAndSource:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
  AND sourceType = :sourceType
  AND (
      (watchedDate IS NULL AND :watchedDate IS NULL) OR watchedDate = :watchedDate
  )
  AND (
      (loggedDate IS NULL AND :loggedDate IS NULL) OR loggedDate = :loggedDate
  )
LIMIT 1;

getLogsForMovie:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
ORDER BY COALESCE(watchedDate, loggedDate) ASC, id ASC;

getLogsForMovieByWatchOrder:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
ORDER BY COALESCE(watchedDate, loggedDate) ASC, id ASC;

updateMovieLog:
UPDATE MovieLogEntity
SET watchedDate = :watchedDate,
    loggedDate = :loggedDate,
    rating = :rating,
    review = :review,
    isRewatch = :isRewatch,
    sourceType = :sourceType
WHERE id = :id;

updateMovieLogRewatch:
UPDATE MovieLogEntity
SET isRewatch = :isRewatch
WHERE id = :id;

updateMovieAddedDate:
UPDATE MovieEntity
SET addedDate = :addedDate
WHERE id = :id;

-- =============================================================================
-- Queries: Movie CRUD
-- =============================================================================

insertMovie:
INSERT INTO MovieEntity(
    name, year, letterboxdUri, imdbId,
    isWatched, inWatchlist, isCached,
    posterPath, backdropPath, overview, runtimeMinutes, tmdbId,
    tagline, originalTitle, originalLanguage, budget, revenue, genres,
    hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount,
    collectionName, trailerKey, mpaaRating, addedDate,studios,
    productionCountries, spokenLanguages, similarMovies, tmdbReviews
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?,
?,?,?,?,?,?,?,?,?,?,
?, ?,?,?,?,?,
?, ?, ?,?,?,?);

updateMovieWithTmdb:
UPDATE MovieEntity
SET posterPath = ?, backdropPath = ?, overview = ?, runtimeMinutes = ?, tmdbId = ?,
    tagline = ?, originalTitle = ?, originalLanguage = ?, budget = ?, revenue = ?, genres = ?,
    hungarianTitle = ?, tmdbPopularity = ?, tmdbVoteAverage = ?, tmdbVoteCount = ?, collectionName = ?, trailerKey = ?,
    mpaaRating = ?, studios = ?, productionCountries = ?, spokenLanguages = ?, similarMovies = ?, tmdbReviews = ?
WHERE id = ?;

updateMovieFlags:
UPDATE MovieEntity
SET isWatched = :isWatched, inWatchlist = :inWatchlist
WHERE id = :id;

deleteAllMovies:
DELETE FROM MovieEntity;

getLastInsertId:
SELECT last_insert_rowid();

insertOrReplaceIgnoredMovie:
INSERT OR REPLACE INTO DiscoveryIgnoredEntity(
  tmdbId,
  title,
  year,
  posterPath,
  overview,
  runtimeMinutes,
  tmdbVoteAverage,
  createdAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteIgnoredMovie:
DELETE FROM DiscoveryIgnoredEntity
WHERE tmdbId = ?;

isMovieIgnored:
SELECT EXISTS(
  SELECT 1
  FROM DiscoveryIgnoredEntity
  WHERE tmdbId = ?
);

getMovieById:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    MovieEntity.isWatched,
    MovieEntity.inWatchlist,
    MovieEntity.isCached,
    MovieEntity.posterPath,
    MovieEntity.backdropPath,
    MovieEntity.overview,
    MovieEntity.runtimeMinutes,
    MovieEntity.tmdbId,
    MovieEntity.tagline,
    MovieEntity.originalTitle,
    MovieEntity.originalLanguage,
    MovieEntity.budget,
    MovieEntity.revenue,
    MovieEntity.genres,
    MovieEntity.hungarianTitle,
    MovieEntity.tmdbPopularity,
    MovieEntity.tmdbVoteAverage,
    MovieEntity.tmdbVoteCount,
    MovieEntity.collectionName,
    MovieEntity.trailerKey,
    MovieEntity.mpaaRating,
    MovieEntity.addedDate,
    MovieEntity.studios,
    MovieEntity.productionCountries,
    MovieEntity.spokenLanguages,
    MovieEntity.similarMovies,
    MovieEntity.tmdbReviews,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    COALESCE(
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        ),
        0
    ) AS isRewatch
FROM MovieEntity
WHERE MovieEntity.id = ?
LIMIT 1;

-- =============================================================================
-- Queries: Movie Lookups
-- =============================================================================
getWatchedMovieIds:
SELECT id
FROM MovieEntity
WHERE isWatched = 1;

getIgnoredMovies:
SELECT *
FROM DiscoveryIgnoredEntity
ORDER BY createdAt DESC;

getMovieByUniqueData:
SELECT * FROM MovieEntity
WHERE (letterboxdUri IS NOT NULL AND letterboxdUri = :uri)
   OR (imdbId IS NOT NULL AND imdbId = :imdb)
   OR (name = :name AND year = :year)
LIMIT 1;

getMovieIdByTmdbId:
SELECT id
FROM MovieEntity
WHERE tmdbId = ?
LIMIT 1;

markMovieCached:
UPDATE MovieEntity
SET isCached = 1
WHERE id = ?;

getAllMovieKeys:
SELECT id, name, year, letterboxdUri, imdbId
FROM MovieEntity;

checkIfExists:
SELECT * FROM MovieEntity
WHERE letterboxdUri = :uri
   OR imdbId = :imdb
   OR (name = :name AND year = :year)
LIMIT 1;

getMoviesToEnrich:
SELECT * FROM MovieEntity
WHERE posterPath IS NULL AND tmdbId IS NULL
LIMIT 40;

countMoviesToEnrich:
SELECT COUNT(*) FROM MovieEntity
WHERE posterPath IS NULL AND tmdbId IS NULL;

-- =============================================================================
-- Queries: For My_Library and Watchlist screen
-- =============================================================================

getWatchedMoviesForList:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.posterPath,
    MovieEntity.tmdbId,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    COALESCE(
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        ),
        0
    ) AS isRewatch
FROM MovieEntity
WHERE MovieEntity.isWatched = 1;

getWatchlistMoviesForList:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.posterPath,
    MovieEntity.tmdbId,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    (
        SELECT COALESCE(watchedDate, loggedDate)
        FROM MovieLogEntity
        WHERE movieId = MovieEntity.id
        ORDER BY COALESCE(watchedDate, loggedDate) DESC, id DESC
        LIMIT 1
    ) AS watchedDate,
    COALESCE((
        SELECT isRewatch
        FROM MovieLogEntity
        WHERE movieId = MovieEntity.id
        ORDER BY COALESCE(watchedDate, loggedDate) DESC, id DESC
        LIMIT 1
    ), 0) AS isRewatch
FROM MovieEntity
WHERE MovieEntity.inWatchlist = 1;

-- Directors and actors use MoviePersonEntity
getMoviesByPersonAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    COALESCE(
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = m.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        ),
        0
    ) AS isRewatch
FROM MovieEntity m
JOIN MoviePersonEntity p ON p.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p.name = :personName
    AND (:job IS NULL OR p.job = :job)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
                  OR (
                      log.watchedDate IS NULL
                      AND log.loggedDate BETWEEN :startDate AND :endDate
                      AND NOT EXISTS (
                          SELECT 1
                          FROM MovieLogEntity w
                          WHERE w.movieId = m.id
                            AND w.watchedDate IS NOT NULL
                      )
                  )
              )
        )
    );

getMoviesByFilterAndDate:
 SELECT
     m.id,
     m.name,
     m.year,
     m.posterPath,
     m.tmdbId,
     m.letterboxdUri,
     m.imdbId,
     COALESCE(
         (
             SELECT log.rating
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.watchedDate IS NOT NULL
               AND log.rating IS NOT NULL
             ORDER BY log.watchedDate DESC, log.id DESC
             LIMIT 1
         ),
         (
             SELECT log.rating
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.loggedDate IS NOT NULL
               AND log.rating IS NOT NULL
               AND NOT EXISTS (
                   SELECT 1
                   FROM MovieLogEntity w
                   WHERE w.movieId = m.id
                     AND w.watchedDate IS NOT NULL
               )
             ORDER BY log.loggedDate DESC, log.id DESC
             LIMIT 1
         )
     ) AS rating,
     COALESCE(
         (
             SELECT log.watchedDate
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.watchedDate IS NOT NULL
             ORDER BY log.watchedDate DESC, log.id DESC
             LIMIT 1
         ),
         (
             SELECT log.loggedDate
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.loggedDate IS NOT NULL
               AND NOT EXISTS (
                   SELECT 1
                   FROM MovieLogEntity w
                   WHERE w.movieId = m.id
                     AND w.watchedDate IS NOT NULL
               )
             ORDER BY log.loggedDate DESC, log.id DESC
             LIMIT 1
         )
     ) AS watchedDate,
     COALESCE(
         (
             SELECT log.isRewatch
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.watchedDate IS NOT NULL
             ORDER BY log.watchedDate DESC, log.id DESC
             LIMIT 1
         ),
         (
             SELECT log.isRewatch
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND log.loggedDate IS NOT NULL
               AND NOT EXISTS (
                   SELECT 1
                   FROM MovieLogEntity w
                   WHERE w.movieId = m.id
                     AND w.watchedDate IS NOT NULL
               )
             ORDER BY log.loggedDate DESC, log.id DESC
             LIMIT 1
         ),
         0
     ) AS isRewatch
 FROM MovieEntity m
 WHERE
     (
         (:listType = 'WATCHED' AND m.isWatched = 1) OR
         (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
     )
     AND (
         (:filterType IS NULL OR :filterName IS NULL)
         OR (:filterType = 'GENRE' AND m.genres LIKE '%' || :filterName || '%')
         OR (:filterType = 'STUDIO' AND m.studios LIKE '%' || :filterName || '%')
         OR (:filterType = 'COUNTRY' AND m.productionCountries LIKE '%' || :filterName || '%')
     )
     AND (
         :listType = 'WATCHLIST'
         OR :startDate IS NULL
         OR :endDate IS NULL
         OR EXISTS (
             SELECT 1
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND (
                   log.watchedDate BETWEEN :startDate AND :endDate
                   OR (
                       log.watchedDate IS NULL
                       AND log.loggedDate BETWEEN :startDate AND :endDate
                       AND NOT EXISTS (
                           SELECT 1
                           FROM MovieLogEntity w
                           WHERE w.movieId = m.id
                             AND w.watchedDate IS NOT NULL
                       )
                   )
               )
         )
     );

-- =============================================================================
-- Queries: Collections (shared SELECT columns for mapper reuse)
-- =============================================================================
getAllMovies:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    MovieEntity.isWatched,
    MovieEntity.inWatchlist,
    MovieEntity.isCached,
    MovieEntity.posterPath,
    MovieEntity.backdropPath,
    MovieEntity.overview,
    MovieEntity.runtimeMinutes,
    MovieEntity.tmdbId,
    MovieEntity.tagline,
    MovieEntity.originalTitle,
    MovieEntity.originalLanguage,
    MovieEntity.budget,
    MovieEntity.revenue,
    MovieEntity.genres,
    MovieEntity.hungarianTitle,
    MovieEntity.tmdbPopularity,
    MovieEntity.tmdbVoteAverage,
    MovieEntity.tmdbVoteCount,
    MovieEntity.collectionName,
    MovieEntity.trailerKey,
    MovieEntity.mpaaRating,
    MovieEntity.addedDate,
    MovieEntity.studios,
    MovieEntity.productionCountries,
    MovieEntity.spokenLanguages,
    MovieEntity.similarMovies,
    MovieEntity.tmdbReviews,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    COALESCE(
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        ),
        0
    ) AS isRewatch
FROM MovieEntity;

