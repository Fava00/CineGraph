getWatchedCollectionRows:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    CAST(NULL AS TEXT) AS watchlistDate
FROM MovieWithLibraryState m
WHERE m.isWatched = 1;

getWatchlistCollectionRows:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieWithLibraryState m
WHERE m.inWatchlist = 1;

getCachedCollectionRows:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieWithLibraryState m
WHERE m.isCached = 1;

getCollectionRowsByPersonAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieWithLibraryState m
JOIN MoviePersonEntity p ON p.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p.name = :personName
    AND (:job IS NULL OR p.job = :job)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
              )
        )
    );

getCollectionRowsByFilterAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieWithLibraryState m
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND (
        (:filterType = 'GENRE' AND m.genres LIKE '%' || :filterName || '%') OR
        (:filterType = 'STUDIO' AND m.studios LIKE '%' || :filterName || '%') OR
        (:filterType = 'COUNTRY' AND m.productionCountries LIKE '%' || :filterName || '%')
    )
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
              )
        )
    );

getCollectionRowsByDuoAndDate:
SELECT DISTINCT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    m.tmdbVoteAverage,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS userRating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    m.addedDate AS watchlistDate
FROM MovieWithLibraryState m
JOIN MoviePersonEntity p1 ON p1.movieId = m.id
JOIN MoviePersonEntity p2 ON p2.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p1.name = :firstName
    AND p2.name = :secondName
    AND p1.id != p2.id
    AND (:firstJob IS NULL OR p1.job = :firstJob)
    AND (:secondJob IS NULL OR p2.job = :secondJob)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
              )
        )
    );

-- =============================================================================
-- Queries: Entity Suggestions
-- =============================================================================
getPersonSuggestionsByJob:
SELECT DISTINCT name
FROM MoviePersonEntity
WHERE job = :job
  AND name LIKE '%' || :query || '%'
ORDER BY name COLLATE NOCASE
LIMIT 8;

getActorActorDuosByDate:
WITH watched_movies AS (
    SELECT DISTINCT m.id
    FROM MovieWithLibraryState m
    WHERE m.isWatched = 1
      AND (
        :startDate IS NULL OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate BETWEEN :startDate AND :endDate
        )
      )
)
SELECT
    CASE WHEN p1.name <= p2.name THEN p1.name ELSE p2.name END AS leftName,
    CASE WHEN p1.name <= p2.name THEN p2.name ELSE p1.name END AS rightName,
    CASE WHEN p1.name <= p2.name THEN COALESCE(p1.profilePath, p2.profilePath)
         ELSE COALESCE(p2.profilePath, p1.profilePath) END AS leftPhotoPath,
    CASE WHEN p1.name <= p2.name THEN COALESCE(p2.profilePath, p1.profilePath)
         ELSE COALESCE(p1.profilePath, p2.profilePath) END AS rightPhotoPath,
    COUNT(DISTINCT wm.id) AS count
FROM watched_movies wm
JOIN MoviePersonEntity p1 ON p1.movieId = wm.id
JOIN MoviePersonEntity p2 ON p2.movieId = wm.id
WHERE p1.job = 'Actor'
  AND p2.job = 'Actor'
  AND p1.id < p2.id
  AND p1.name != p2.name
GROUP BY leftName, rightName
HAVING COUNT(DISTINCT wm.id) >= 2
ORDER BY count DESC, leftName ASC, rightName ASC;

getActorDirectorDuosByDate:
WITH watched_movies AS (
    SELECT DISTINCT m.id
    FROM MovieWithLibraryState m
    WHERE m.isWatched = 1
      AND (
        :startDate IS NULL OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND log.watchedDate BETWEEN :startDate AND :endDate
        )
      )
)
SELECT
    actor.name AS leftName,
    director.name AS rightName,
    actor.profilePath AS leftPhotoPath,
    director.profilePath AS rightPhotoPath,
    COUNT(DISTINCT wm.id) AS count
FROM watched_movies wm
JOIN MoviePersonEntity actor ON actor.movieId = wm.id
JOIN MoviePersonEntity director ON director.movieId = wm.id
WHERE actor.job = 'Actor'
  AND director.job = 'Director'
  AND actor.name != director.name
GROUP BY actor.name, director.name
HAVING COUNT(DISTINCT wm.id) >= 2
ORDER BY count DESC, leftName ASC, rightName ASC;


deleteAllData:
DELETE FROM MovieEntity;
DELETE FROM MovieLogEntity;
DELETE FROM MoviePersonEntity;

-- =============================================================================
-- For Exports
-- =============================================================================


selectAllMovieEntities:
SELECT * FROM MovieWithLibraryState AS MovieEntity ORDER BY id;

selectAllMoviePersons:
SELECT * FROM MoviePersonEntity ORDER BY movieId, id;

selectAllMovieLogs:
SELECT * FROM MovieLogEntity ORDER BY movieId, watchedDate IS NULL ASC, watchedDate, stableId;

selectAllCustomLists:
SELECT * FROM CustomList ORDER BY id;

selectAllListEntries:
SELECT * FROM ListEntry ORDER BY listId, movieId;

selectAllIgnoredMovies:
SELECT * FROM DiscoveryIgnoredEntity ORDER BY createdAt DESC;

selectBackupMovies:
SELECT * FROM MovieWithLibraryState AS MovieEntity WHERE MovieEntity.id > :afterId ORDER BY MovieEntity.id LIMIT 500;

selectBackupPeople:
SELECT * FROM MoviePersonEntity WHERE id > :afterId ORDER BY id LIMIT 500;

selectBackupLogs:
SELECT * FROM MovieLogEntity WHERE id > :afterId ORDER BY id LIMIT 500;

selectBackupLists:
SELECT * FROM CustomList WHERE id > :afterId ORDER BY id LIMIT 500;

selectBackupEntries:
SELECT * FROM ListEntry
WHERE listId > :afterListId OR (listId = :afterListId AND movieId > :afterMovieId)
ORDER BY listId, movieId LIMIT 500;

selectBackupIgnored:
SELECT * FROM DiscoveryIgnoredEntity WHERE tmdbId > :afterId ORDER BY tmdbId LIMIT 500;


-- Restore explicit IDs to preserve relationships and same-date log ordering.

restoreMovie {
INSERT INTO MovieEntity (id, name, year, letterboxdUri, imdbId, isCached, posterPath, backdropPath, overview, runtimeMinutes, tmdbId, tagline, originalTitle, originalLanguage, budget, revenue, genres, hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount, collectionName, trailerKey, mpaaRating, studios, productionCountries, spokenLanguages, similarMovies, tmdbReviews)
VALUES (:id, :name, :year, :letterboxdUri, :imdbId, :isCached, :posterPath, :backdropPath, :overview, :runtimeMinutes, :tmdbId, :tagline, :originalTitle, :originalLanguage, :budget, :revenue, :genres, :hungarianTitle, :tmdbPopularity, :tmdbVoteAverage, :tmdbVoteCount, :collectionName, :trailerKey, :mpaaRating, :studios, :productionCountries, :spokenLanguages, :similarMovies, :tmdbReviews);
INSERT INTO LibraryMovieEntity (movieId, isWatched, inWatchlist, addedDate)
VALUES (:id, :isWatched, :inWatchlist, :addedDate);
}

restoreMoviePerson:
INSERT INTO MoviePersonEntity (id, movieId, name, job, character, profilePath)
VALUES (:id, :movieId, :name, :job, :character, :profilePath);

restoreMovieLog:
INSERT INTO MovieLogEntity (id, movieId, watchedDate, loggedDate, rating, review, isRewatch, sourceType)
VALUES (:id, :movieId, :watchedDate, :loggedDate, :rating, :review, :isRewatch, :sourceType);

restoreCustomList:
INSERT INTO CustomList (id, name)
VALUES (:id, :name);

restoreListEntry:
INSERT INTO ListEntry (listId, movieId)
VALUES (:listId, :movieId);

clearForBackupRestore {
    DELETE FROM ListEntry;
    DELETE FROM CustomList;
    DELETE FROM MovieLogEntity;
    DELETE FROM MoviePersonEntity;
    DELETE FROM LibraryMovieEntity;
    DELETE FROM MovieEntity;
    DELETE FROM DiscoveryIgnoredEntity;
}

restoreMovieIdentity:
UPDATE MovieEntity SET stableId = :stableId WHERE id = :id;
restoreLibraryIdentity:
UPDATE LibraryMovieEntity SET stableId = :stableId WHERE movieId = :movieId;
restoreLogIdentity:
UPDATE MovieLogEntity SET stableId = :stableId WHERE id = :id;
restoreListIdentity:
UPDATE CustomList SET stableId = :stableId WHERE id = :id;

deleteLibraryState:
DELETE FROM LibraryMovieEntity WHERE movieId = :movieId;

setLogRatingDate:
UPDATE MovieLogEntity SET ratedDate = :ratedDate WHERE id = :id;
restoreLogDates:
UPDATE MovieLogEntity SET ratedDate = :ratedDate, createdAt = :createdAt WHERE id = :id;
getCurrentRatings:
SELECT * FROM CurrentMovieRating;

-- Cache metadata for remote detail cards without creating personal library membership.
insertCachedMovieIdentity:
INSERT INTO MovieEntity(name, year, tmdbId, isCached) VALUES (:name, :year, :tmdbId, 1);

searchMyLibrary:
SELECT m.id, m.name, m.year, m.tmdbId, m.posterPath, m.overview,
       l.isWatched, l.inWatchlist
FROM MovieEntity m
JOIN LibraryMovieEntity l ON l.movieId = m.id
WHERE instr(lower(m.name), lower(:query)) > 0
ORDER BY m.name COLLATE NOCASE, m.year
LIMIT 100;

searchLinkedTmdbMovie:
SELECT m.id, m.name, m.year, m.tmdbId, m.posterPath, m.overview,
       COALESCE(l.isWatched, 0) AS isWatched,
       COALESCE(l.inWatchlist, 0) AS inWatchlist,
       CASE WHEN l.movieId IS NULL THEN 0 ELSE 1 END AS isInLibrary
FROM MovieEntity m
LEFT JOIN LibraryMovieEntity l ON l.movieId = m.id
WHERE m.tmdbId = :tmdbId
LIMIT 1;

findMovieByNameYear:
SELECT id FROM MovieEntity
WHERE name = :name COLLATE NOCASE AND year = :year
LIMIT 1;

addMovieToWatchlist {
INSERT OR IGNORE INTO LibraryMovieEntity(movieId) VALUES (:movieId);
UPDATE LibraryMovieEntity
SET addedDate = CASE WHEN inWatchlist = 0 THEN :addedDate ELSE addedDate END,
    inWatchlist = 1
WHERE movieId = :movieId;
}

markMovieViewed {
INSERT OR IGNORE INTO LibraryMovieEntity(movieId) VALUES (:movieId);
UPDATE LibraryMovieEntity SET isWatched = 1, inWatchlist = 0 WHERE movieId = :movieId;
}

markMovieRated {
INSERT OR IGNORE INTO LibraryMovieEntity(movieId) VALUES (:movieId);
UPDATE LibraryMovieEntity SET isWatched = 1 WHERE movieId = :movieId;
}

deletePersonalMovieLog:
DELETE FROM MovieLogEntity WHERE id = :logId AND movieId = :movieId;

updateWatchedFromLogs:
UPDATE LibraryMovieEntity
SET isWatched = CASE WHEN EXISTS (
    SELECT 1 FROM MovieLogEntity
    WHERE movieId = :movieId AND (upper(sourceType) NOT IN ('RATINGS', 'MANUAL_RATING') OR watchedDate IS NOT NULL)
) THEN 1 ELSE 0 END
WHERE movieId = :movieId;

deletePersonalMovie:
DELETE FROM MovieEntity WHERE id = :movieId;

analyticsChangeSignal:
SELECT
    (SELECT COUNT(*) FROM MovieEntity) AS movies,
    (SELECT COUNT(*) FROM LibraryMovieEntity) AS library,
    (SELECT COUNT(*) FROM MovieLogEntity) AS logs,
    (SELECT COUNT(*) FROM MoviePersonEntity) AS people;

getAnalyticsViewingLogs:
SELECT log.movieId, log.watchedDate, log.isRewatch, log.stableId
FROM MovieLogEntity log
JOIN LibraryMovieEntity library ON library.movieId = log.movieId
WHERE library.isWatched = 1 AND (upper(log.sourceType) NOT IN ('RATINGS', 'MANUAL_RATING') OR log.watchedDate IS NOT NULL)
ORDER BY log.movieId, log.watchedDate IS NULL, log.watchedDate, log.stableId;

setLogCreationTime:
UPDATE MovieLogEntity SET createdAt = :createdAt WHERE id = :id;
