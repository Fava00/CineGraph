-- =============================================================================
-- SQLDelight schema version 2 (first versioned migration)
-- Added: hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount,
--        collectionName, trailerKey, mpaaRating, studios, productionCountries,
--        spokenLanguages, similarMovies (JSON), tmdbReviews (JSON), addedDate
-- =============================================================================

CREATE TABLE MovieEntity (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    year INTEGER NOT NULL,
    letterboxdUri TEXT UNIQUE,
    imdbId TEXT UNIQUE,

    isCached INTEGER NOT NULL DEFAULT 0,

    posterPath TEXT,
    backdropPath TEXT,
    overview TEXT,
    runtimeMinutes INTEGER,
    tmdbId TEXT,

    tagline TEXT,
    originalTitle TEXT,
    originalLanguage TEXT,
    budget INTEGER,
    revenue INTEGER,
    genres TEXT,

    -- New in v2
    hungarianTitle TEXT,
    tmdbPopularity REAL,
    tmdbVoteAverage REAL,
    tmdbVoteCount INTEGER,
    collectionName TEXT,
    trailerKey TEXT,
    mpaaRating TEXT,
    studios TEXT,
    productionCountries TEXT,
    spokenLanguages TEXT,
    similarMovies TEXT,
    tmdbReviews TEXT
);

-- Recovery archive for legacy cached credits whose movie no longer exists.
-- Intentionally has no foreign key; rows retain their original identity and content.
CREATE TABLE IF NOT EXISTS RecoveryMoviePersonEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    originalId INTEGER NOT NULL,
    movieId INTEGER NOT NULL,
    name TEXT NOT NULL,
    job TEXT NOT NULL,
    character TEXT,
    profilePath TEXT
);

CREATE TABLE MoviePersonEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    name TEXT NOT NULL,
    job TEXT NOT NULL,
    character TEXT,
    profilePath TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE MovieLogEntity (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    movieId INTEGER NOT NULL,
    watchedDate TEXT,
    loggedDate TEXT,
    rating REAL,
    review TEXT,
    isRewatch INTEGER NOT NULL DEFAULT 0,
    sourceType TEXT NOT NULL,
    ratedDate TEXT,
    createdAt TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE CustomList (
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE ListEntry (
    listId INTEGER NOT NULL,
    movieId INTEGER NOT NULL,
    PRIMARY KEY (listId, movieId),
    FOREIGN KEY (listId) REFERENCES CustomList(id) ON DELETE CASCADE,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE TABLE DiscoveryIgnoredEntity (
  tmdbId INTEGER NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  year INTEGER,
  posterPath TEXT,
  overview TEXT,
  runtimeMinutes INTEGER,
  tmdbVoteAverage REAL,
  createdAt TEXT NOT NULL
);

CREATE TABLE LibraryMovieEntity (
    movieId INTEGER NOT NULL PRIMARY KEY,
    stableId TEXT NOT NULL UNIQUE DEFAULT (lower(hex(randomblob(16)))),
    isWatched INTEGER NOT NULL DEFAULT 0,
    inWatchlist INTEGER NOT NULL DEFAULT 0,
    addedDate TEXT,
    FOREIGN KEY (movieId) REFERENCES MovieEntity(id) ON DELETE CASCADE
);

CREATE VIEW CurrentMovieRating AS
SELECT log.movieId, log.rating, COALESCE(log.watchedDate, log.ratedDate) AS effectiveDate, log.stableId
FROM MovieLogEntity log
WHERE log.id = (
    SELECT candidate.id FROM MovieLogEntity candidate
    WHERE candidate.movieId = log.movieId
      AND candidate.rating BETWEEN 0.5 AND 5.0
      AND candidate.rating * 2 = CAST(candidate.rating * 2 AS INTEGER)
    ORDER BY COALESCE(candidate.watchedDate, candidate.ratedDate) DESC,
        CASE WHEN candidate.sourceType = 'MANUAL_RATING' THEN 1 ELSE 0 END DESC,
        CASE WHEN candidate.sourceType = 'MANUAL_RATING' THEN julianday(candidate.createdAt) ELSE NULL END DESC,
        candidate.stableId DESC
    LIMIT 1
);

CREATE VIEW MovieWithLibraryState AS
SELECT
    m.id,
    m.name,
    m.year,
    m.letterboxdUri,
    m.imdbId,
    COALESCE(l.isWatched, 0) AS isWatched,
    COALESCE(l.inWatchlist, 0) AS inWatchlist,
    m.isCached,
    m.posterPath,
    m.backdropPath,
    m.overview,
    m.runtimeMinutes,
    m.tmdbId,
    m.tagline,
    m.originalTitle,
    m.originalLanguage,
    m.budget,
    m.revenue,
    m.genres,
    m.hungarianTitle,
    m.tmdbPopularity,
    m.tmdbVoteAverage,
    m.tmdbVoteCount,
    m.collectionName,
    m.trailerKey,
    m.mpaaRating,
    l.addedDate,
    m.studios,
    m.productionCountries,
    m.spokenLanguages,
    m.similarMovies,
    m.tmdbReviews,
    m.stableId,
    l.stableId AS libraryStableId
FROM MovieEntity m
LEFT JOIN LibraryMovieEntity l ON l.movieId = m.id;

-- =============================================================================
-- Indexes for performance-critical queries
-- =============================================================================

CREATE INDEX IF NOT EXISTS idx_librarymovie_iswatched
ON LibraryMovieEntity(isWatched);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_date
ON MovieLogEntity(movieId, watchedDate);

CREATE INDEX IF NOT EXISTS idx_movieperson_movie
ON MoviePersonEntity(movieId);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_watched
ON MovieLogEntity(movieId, watchedDate);

CREATE INDEX IF NOT EXISTS idx_movielog_movie_logged
ON MovieLogEntity(movieId, loggedDate);

CREATE INDEX IF NOT EXISTS idx_movieperson_movie_job_name
ON MoviePersonEntity(movieId, job, name);

CREATE INDEX IF NOT EXISTS idx_movieperson_job_name_movie
ON MoviePersonEntity(job, name, movieId);

-- =============================================================================
-- Queries: Persons
-- =============================================================================

insertMoviePerson:
INSERT INTO MoviePersonEntity(movieId, name, job, character, profilePath)
VALUES (?, ?, ?, ?, ?);

deletePersonsForMovie:
DELETE FROM MoviePersonEntity
WHERE movieId = ?;

getPersonsForMovie:
SELECT *
FROM MoviePersonEntity
WHERE movieId = ?;

getPersonsForMovies:
SELECT *
FROM MoviePersonEntity
WHERE movieId IN ?;

-- =============================================================================
-- Queries: Movie Log
-- =============================================================================

insertMovieLog:
INSERT INTO MovieLogEntity(movieId, watchedDate, loggedDate, rating, review, isRewatch, sourceType, ratedDate, createdAt)
VALUES (:movieId, :watchedDate, :loggedDate, :rating, :review, :isRewatch, :sourceType,
    NULL,
    strftime('%Y-%m-%dT%H:%M:%fZ', 'now'));

getLogByMovieAndDate:
SELECT * FROM MovieLogEntity
WHERE movieId = :movieId
  AND ((watchedDate IS NULL AND :date IS NULL) OR (watchedDate = :date))
LIMIT 1;

getLogByMovieAndSource:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
  AND sourceType = :sourceType
  AND (
      (watchedDate IS NULL AND :watchedDate IS NULL) OR watchedDate = :watchedDate
  )
  AND (
      (loggedDate IS NULL AND :loggedDate IS NULL) OR loggedDate = :loggedDate
  )
LIMIT 1;

getLogsForMovie:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
ORDER BY watchedDate IS NULL ASC, watchedDate ASC, stableId ASC;

deleteImportedLog:
DELETE FROM MovieLogEntity WHERE id = :id;

getLogsForMovieByWatchOrder:
SELECT *
FROM MovieLogEntity
WHERE movieId = :movieId
ORDER BY watchedDate IS NULL ASC, watchedDate ASC, stableId ASC;

updateMovieLog:
UPDATE MovieLogEntity
SET watchedDate = :watchedDate,
    loggedDate = :loggedDate,
    rating = :rating,
    review = :review,
    isRewatch = :isRewatch,
    sourceType = :sourceType
WHERE id = :id;

updateMovieLogRewatch:
UPDATE MovieLogEntity
SET isRewatch = :isRewatch
WHERE id = :id;

updateMovieAddedDate {
INSERT OR IGNORE INTO LibraryMovieEntity(movieId) VALUES (:id);
UPDATE LibraryMovieEntity SET addedDate = :addedDate WHERE movieId = :id;
}

-- =============================================================================
-- Queries: Movie CRUD
-- =============================================================================

insertMovie {
INSERT INTO MovieEntity (name, year, letterboxdUri, imdbId, isCached, posterPath, backdropPath, overview, runtimeMinutes, tmdbId, tagline, originalTitle, originalLanguage, budget, revenue, genres, hungarianTitle, tmdbPopularity, tmdbVoteAverage, tmdbVoteCount, collectionName, trailerKey, mpaaRating, studios, productionCountries, spokenLanguages, similarMovies, tmdbReviews)
VALUES (:name, :year, :letterboxdUri, :imdbId, :isCached, :posterPath, :backdropPath, :overview, :runtimeMinutes, :tmdbId, :tagline, :originalTitle, :originalLanguage, :budget, :revenue, :genres, :hungarianTitle, :tmdbPopularity, :tmdbVoteAverage, :tmdbVoteCount, :collectionName, :trailerKey, :mpaaRating, :studios, :productionCountries, :spokenLanguages, :similarMovies, :tmdbReviews);
INSERT INTO LibraryMovieEntity (movieId, isWatched, inWatchlist, addedDate)
VALUES (last_insert_rowid(), :isWatched, :inWatchlist, :addedDate);
}

updateMovieWithTmdb:
UPDATE MovieEntity
SET posterPath = ?, backdropPath = ?, overview = ?, runtimeMinutes = ?, tmdbId = ?,
    tagline = ?, originalTitle = ?, originalLanguage = ?, budget = ?, revenue = ?, genres = ?,
    hungarianTitle = ?, tmdbPopularity = ?, tmdbVoteAverage = ?, tmdbVoteCount = ?, collectionName = ?, trailerKey = ?,
    mpaaRating = ?, studios = ?, productionCountries = ?, spokenLanguages = ?, similarMovies = ?, tmdbReviews = ?,
    imdbId = COALESCE(NULLIF(:imdbId, ''), imdbId)
WHERE id = ?;

markMovieUnmatched:
UPDATE MovieEntity SET tmdbId = '-1' WHERE id = :id AND tmdbId IS NULL;

updateMissingImdbId:
UPDATE MovieEntity SET imdbId = :imdbId
WHERE id = :id AND tmdbId = :tmdbId AND (imdbId IS NULL OR trim(imdbId) = '');

getMoviesMissingExportImdbId:
SELECT m.id, m.name, m.tmdbId FROM MovieEntity m
JOIN LibraryMovieEntity l ON l.movieId = m.id
WHERE (m.imdbId IS NULL OR trim(m.imdbId) = '')
AND (l.inWatchlist = 1 OR EXISTS (SELECT 1 FROM CurrentMovieRating r WHERE r.movieId = m.id));

getImdbExportIdentities:
SELECT m.id, m.name, m.tmdbId FROM MovieEntity m
JOIN LibraryMovieEntity l ON l.movieId = m.id
WHERE m.tmdbId IS NOT NULL AND trim(m.tmdbId) <> '' AND m.tmdbId <> '-1'
AND (l.inWatchlist = 1 OR EXISTS (SELECT 1 FROM CurrentMovieRating r WHERE r.movieId = m.id));

getStoredImdbIds:
SELECT id, name, imdbId FROM MovieEntity
WHERE imdbId IS NOT NULL AND trim(imdbId) <> '';

getImdbExportMovies:
SELECT m.id, m.name, m.year, m.imdbId, m.originalTitle, m.runtimeMinutes, m.genres,
       COALESCE(l.inWatchlist, 0) AS inWatchlist, l.addedDate
FROM MovieEntity m
LEFT JOIN LibraryMovieEntity l ON l.movieId = m.id;

updateMovieFlags {
INSERT OR IGNORE INTO LibraryMovieEntity(movieId) VALUES (:id);
UPDATE LibraryMovieEntity SET isWatched = :isWatched, inWatchlist = :inWatchlist WHERE movieId = :id;
}

deleteAllMovies:
DELETE FROM MovieEntity;

getLastInsertId:
SELECT last_insert_rowid();

insertOrReplaceIgnoredMovie:
INSERT OR REPLACE INTO DiscoveryIgnoredEntity(
  tmdbId,
  title,
  year,
  posterPath,
  overview,
  runtimeMinutes,
  tmdbVoteAverage,
  createdAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteIgnoredMovie:
DELETE FROM DiscoveryIgnoredEntity
WHERE tmdbId = ?;

isMovieIgnored:
SELECT EXISTS(
  SELECT 1
  FROM DiscoveryIgnoredEntity
  WHERE tmdbId = ?
);

getMovieById:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    MovieEntity.isWatched,
    MovieEntity.inWatchlist,
    MovieEntity.isCached,
    MovieEntity.posterPath,
    MovieEntity.backdropPath,
    MovieEntity.overview,
    MovieEntity.runtimeMinutes,
    MovieEntity.tmdbId,
    MovieEntity.tagline,
    MovieEntity.originalTitle,
    MovieEntity.originalLanguage,
    MovieEntity.budget,
    MovieEntity.revenue,
    MovieEntity.genres,
    MovieEntity.hungarianTitle,
    MovieEntity.tmdbPopularity,
    MovieEntity.tmdbVoteAverage,
    MovieEntity.tmdbVoteCount,
    MovieEntity.collectionName,
    MovieEntity.trailerKey,
    MovieEntity.mpaaRating,
    MovieEntity.addedDate,
    MovieEntity.studios,
    MovieEntity.productionCountries,
    MovieEntity.spokenLanguages,
    MovieEntity.similarMovies,
    MovieEntity.tmdbReviews,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = MovieEntity.id) AS rating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = MovieEntity.id) AS watchedDate,
    COALESCE((SELECT isRewatch FROM MovieLogEntity WHERE movieId = MovieEntity.id AND watchedDate IS NOT NULL ORDER BY watchedDate DESC, stableId DESC LIMIT 1), 0) AS isRewatch
FROM MovieWithLibraryState AS MovieEntity
WHERE MovieEntity.id = ?
LIMIT 1;

-- =============================================================================
-- Queries: Movie Lookups
-- =============================================================================
getWatchedMovieIds:
SELECT id
FROM MovieWithLibraryState AS MovieEntity
WHERE isWatched = 1;

getIgnoredMovies:
SELECT *
FROM DiscoveryIgnoredEntity
ORDER BY createdAt DESC;

getMovieByUniqueData:
SELECT * FROM MovieWithLibraryState AS MovieEntity
WHERE (letterboxdUri IS NOT NULL AND letterboxdUri = :uri)
   OR (imdbId IS NOT NULL AND imdbId = :imdb)
   OR (name = :name AND year = :year)
LIMIT 1;

getMovieIdByTmdbId:
SELECT id
FROM MovieWithLibraryState AS MovieEntity
WHERE tmdbId = ?
LIMIT 1;

getMovieIdByImdbId:
SELECT id FROM MovieEntity WHERE imdbId = :imdbId LIMIT 1;

markMovieCached:
UPDATE MovieEntity
SET isCached = 1
WHERE id = ?;

getAllMovieKeys:
SELECT id, name, year, letterboxdUri, imdbId
FROM MovieWithLibraryState AS MovieEntity;

checkIfExists:
SELECT * FROM MovieWithLibraryState AS MovieEntity
WHERE letterboxdUri = :uri
   OR imdbId = :imdb
   OR (name = :name AND year = :year)
LIMIT 1;

getMoviesToEnrich:
SELECT * FROM MovieWithLibraryState AS MovieEntity
WHERE posterPath IS NULL AND tmdbId IS NULL AND MovieEntity.id > :afterId
ORDER BY MovieEntity.id
LIMIT 40;

countMoviesToEnrich:
SELECT COUNT(*) FROM MovieWithLibraryState AS MovieEntity
WHERE posterPath IS NULL AND tmdbId IS NULL;

getUnmatchedTmdbMovies:
SELECT m.id, m.name, m.year, m.imdbId, m.letterboxdUri,
       COALESCE(l.isWatched, 0) AS isWatched,
       COALESCE(l.inWatchlist, 0) AS inWatchlist,
       (SELECT COUNT(*) FROM MovieLogEntity log WHERE log.movieId = m.id) AS logCount,
       (SELECT COUNT(*) FROM ListEntry entry WHERE entry.movieId = m.id) AS listCount
FROM MovieEntity m
LEFT JOIN LibraryMovieEntity l ON l.movieId = m.id
WHERE m.tmdbId = '-1'
ORDER BY m.name COLLATE NOCASE, m.year, m.id;

deleteUnmatchedMovie:
DELETE FROM MovieEntity WHERE id = :id AND tmdbId = '-1';

getUnmatchedMoviesToEnrich:
SELECT * FROM MovieWithLibraryState AS MovieEntity
WHERE tmdbId = '-1' AND MovieEntity.id > :afterId
ORDER BY MovieEntity.id
LIMIT 40;

countUnmatchedMoviesToEnrich:
SELECT COUNT(*) FROM MovieEntity WHERE tmdbId = '-1';


-- =============================================================================
-- Queries: For My_Library and Watchlist screen
-- =============================================================================

getWatchedMoviesForList:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.posterPath,
    MovieEntity.tmdbId,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = MovieEntity.id) AS rating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = MovieEntity.id) AS watchedDate,
    COALESCE((SELECT isRewatch FROM MovieLogEntity WHERE movieId = MovieEntity.id AND watchedDate IS NOT NULL ORDER BY watchedDate DESC, stableId DESC LIMIT 1), 0) AS isRewatch
FROM MovieWithLibraryState AS MovieEntity
WHERE MovieEntity.isWatched = 1;

getWatchlistMoviesForList:
SELECT
    MovieEntity.id,
    MovieEntity.name,
    MovieEntity.year,
    MovieEntity.posterPath,
    MovieEntity.tmdbId,
    MovieEntity.letterboxdUri,
    MovieEntity.imdbId,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = MovieEntity.id) AS rating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = MovieEntity.id) AS watchedDate,
    COALESCE((SELECT isRewatch FROM MovieLogEntity WHERE movieId = MovieEntity.id AND watchedDate IS NOT NULL ORDER BY watchedDate DESC, stableId DESC LIMIT 1), 0) AS isRewatch
FROM MovieWithLibraryState AS MovieEntity
WHERE MovieEntity.inWatchlist = 1;

-- Directors and actors use MoviePersonEntity
getMoviesByPersonAndDate:
SELECT
    m.id,
    m.name,
    m.year,
    m.posterPath,
    m.tmdbId,
    m.letterboxdUri,
    m.imdbId,
    (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS rating,
    (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
    COALESCE((SELECT isRewatch FROM MovieLogEntity WHERE movieId = m.id AND watchedDate IS NOT NULL ORDER BY watchedDate DESC, stableId DESC LIMIT 1), 0) AS isRewatch
FROM MovieWithLibraryState m
JOIN MoviePersonEntity p ON p.movieId = m.id
WHERE
    (
        (:listType = 'WATCHED' AND m.isWatched = 1) OR
        (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
    )
    AND p.name = :personName
    AND (:job IS NULL OR p.job = :job)
    AND (
        :listType = 'WATCHLIST'
        OR :startDate IS NULL
        OR :endDate IS NULL
        OR EXISTS (
            SELECT 1
            FROM MovieLogEntity log
            WHERE log.movieId = m.id
              AND (
                  log.watchedDate BETWEEN :startDate AND :endDate
              )
        )
    );

getMoviesByFilterAndDate:
 SELECT
     m.id,
     m.name,
     m.year,
     m.posterPath,
     m.tmdbId,
     m.letterboxdUri,
     m.imdbId,
     (SELECT rating FROM CurrentMovieRating WHERE movieId = m.id) AS rating,
     (SELECT MAX(watchedDate) FROM MovieLogEntity WHERE movieId = m.id) AS watchedDate,
     COALESCE((SELECT isRewatch FROM MovieLogEntity WHERE movieId = m.id AND watchedDate IS NOT NULL ORDER BY watchedDate DESC, stableId DESC LIMIT 1), 0) AS isRewatch
 FROM MovieWithLibraryState m
 WHERE
     (
         (:listType = 'WATCHED' AND m.isWatched = 1) OR
         (:listType = 'WATCHLIST' AND m.inWatchlist = 1)
     )
     AND (
         (:filterType IS NULL OR :filterName IS NULL)
         OR (:filterType = 'GENRE' AND m.genres LIKE '%' || :filterName || '%')
         OR (:filterType = 'STUDIO' AND m.studios LIKE '%' || :filterName || '%')
         OR (:filterType = 'COUNTRY' AND m.productionCountries LIKE '%' || :filterName || '%')
     )
     AND (
         :listType = 'WATCHLIST'
         OR :startDate IS NULL
         OR :endDate IS NULL
         OR EXISTS (
             SELECT 1
             FROM MovieLogEntity log
             WHERE log.movieId = m.id
               AND (
                   log.watchedDate BETWEEN :startDate AND :endDate
               )
         )
     );

