    MovieEntity.studios,
    MovieEntity.productionCountries,
    MovieEntity.spokenLanguages,
    MovieEntity.similarMovies,
    MovieEntity.tmdbReviews,
    COALESCE(
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
              AND log.rating IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.rating
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND log.rating IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS rating,
    COALESCE(
        (
            SELECT log.watchedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.loggedDate
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        )
    ) AS watchedDate,
    COALESCE(
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.watchedDate IS NOT NULL
            ORDER BY log.watchedDate DESC, log.id DESC
            LIMIT 1
        ),
        (
            SELECT log.isRewatch
            FROM MovieLogEntity log
            WHERE log.movieId = MovieEntity.id
              AND log.loggedDate IS NOT NULL
              AND NOT EXISTS (
                  SELECT 1
                  FROM MovieLogEntity w
                  WHERE w.movieId = MovieEntity.id
                    AND w.watchedDate IS NOT NULL
              )
            ORDER BY log.loggedDate DESC, log.id DESC
            LIMIT 1
        ),
        0
    ) AS isRewatch
FROM MovieEntity
WHERE MovieEntity.isWatched = 1;

